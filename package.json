{
	"name": "tb-notearkiv",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port ${PORT:-3000}",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"deploy": "pnpm run build && wrangler deploy",
