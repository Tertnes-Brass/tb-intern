/**
 * Cloudflare Workers-konfigurasjon for tb-notearkiv.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tb-notearkiv",
	"account_id": "3709ec57046e3f629f737cf5b6b88a82",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	// Egen worker-entry (src/worker.ts) i stedet for Start sin
	// "@tanstack/react-start/server-entry": vi trenger en `scheduled`-handler
	// ved siden av `fetch`. Entryen sender `fetch` rett videre til Start.
	"main": "src/worker.ts",
	// Daglig påminnelse om forfalte styreoppgaver. 07:00 UTC ≈ 09:00 norsk tid
	// (08:00 om vinteren). Handleren ligger i src/worker.ts og kaller
	// `runOverdueReminders` i src/server/board-notify.ts, som selv sørger for at
	// den kjører maks én gang per kalenderdag.
	"triggers": {
		"crons": ["0 7 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		// Ikke-hemmelige variabler. Hemmeligheter (BETTER_AUTH_SECRET) settes med
		// `wrangler secret put` i prod og i .dev.vars lokalt.
		// Kanonisk origin for hele internsiden: auth-callbacks, magiske lenker,
		// passordreset og vikarlenker bygges alle fra denne. Neste deploy er
		// selve cutover-tidspunktet — auth-origin bytter da til intern.-domenet,
		// og gamle magiske lenker mot noter.-domenet 301-es hit (se
		// src/lib/host-redirect.ts). Rollback = sett verdien tilbake og deploy.
		"BETTER_AUTH_URL": "https://intern.tertnesbrass.com",
		// Første bruker med denne e-posten promoteres automatisk til admin.
		"ADMIN_EMAIL": "sindre.ryland@gmail.com",
		// Kalender: offentlig embed-URL fra Google Calendar (Innstillinger →
		// kalenderen → «Integrer kalender» → «Bygg inn kode»/«Offentlig URL til
		// denne kalenderen»). Tom = ingen innebygd kalender nederst på /kalender.
		// Selve hendelseslista kommer fra den HEMMELIGE iCal-adressen, som settes
		// som secret: `wrangler secret put CALENDAR_ICS_URL` (aldri i denne fila).
		"CALENDAR_EMBED_URL": "https://calendar.google.com/calendar/embed?src=0ieontn6bgp0f9loh031ba9hgc%40group.calendar.google.com&ctz=Europe%2FOslo"
	},
	// Sonen tertnesbrass.com ligger i Cloudflare, så `wrangler deploy` oppretter
	// DNS-oppføringen for custom domains automatisk — ingen manuelle DNS-steg.
	// NB: Worker-navnet over («tb-notearkiv») skal IKKE endres selv om repoet
	// døpes om til tb-intern. Nytt navn = ny Worker uten bindinger og secrets.
	"routes": [
		{
			"pattern": "intern.tertnesbrass.com",
			"custom_domain": true
		},
		// Det gamle domenet må bestå: koden 301-er all trafikk herfra til
		// intern.tertnesbrass.com, inkludert /api/* og /v/* i gamle e-poster.
		{
			"pattern": "noter.tertnesbrass.com",
			"custom_domain": true
		}
	],
	// workers.dev-adresse i tillegg til custom domain (praktisk delbar URL)
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tb-notearkiv",
			"database_id": "e4b81185-85e0-4838-880a-2336293b8838",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "tb-notearkiv-files"
		}
	],
	// Cloudflare Email Sending — magisk lenke + passord-reset. Domenet onboardes
	// med `wrangler email sending enable tertnesbrass.com` (setter opp DKIM/SPF automatisk).
	"send_email": [{ "name": "EMAIL" }]
}
